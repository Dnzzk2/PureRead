{
  "manifest_version": 3,
  "name": "PureRead",
  "version": "1.1.0",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "permissions": ["storage", "activeTab", "fontSettings", "alarms"],
  "action": {
    "default_icon": {
      "16": "public/PureRead-icon-16.png",
      "32": "public/PureRead-icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["i18n.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "public/PureRead-icon-16.png",
    "32": "public/PureRead-icon-32.png",
    "48": "public/PureRead-icon-48.png",
    "128": "public/PureRead-icon-128.png"
  }
}
